{
  "manifest_version": 3,
  "name": "Omnibox",
  "version": "1.0.0",
  "description": "Add a keyword to the address bar with chrome.omnibox.",
  "minimum_chrome_version": "88",
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "ext"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
