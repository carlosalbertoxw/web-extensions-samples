{
  "manifest_version": 3,
  "name": "Scripting",
  "version": "1.0.0",
  "description": "Inject code and styles into a page on demand with chrome.scripting.",
  "minimum_chrome_version": "88",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "action": {
    "default_title": "Scripting",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
