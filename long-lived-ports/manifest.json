{
  "manifest_version": 3,
  "name": "Long-lived ports",
  "version": "1.0.0",
  "description": "Keep an open channel with the service worker using chrome.runtime.connect.",
  "minimum_chrome_version": "88",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Long-lived ports",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
