{
  "manifest_version": 3,
  "name": "Cross-browser",
  "version": "1.0.0",
  "description": "One codebase that runs on Chrome, Opera and Firefox.",
  "minimum_chrome_version": "92",
  "browser_specific_settings": {
    "gecko": {
      "id": "cross-browser@web-extensions-samples",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Cross-browser",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
