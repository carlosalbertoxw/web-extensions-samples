{
  "manifest_version": 3,
  "name": "Action onClicked",
  "version": "1.0.0",
  "description": "React to the toolbar icon directly, without opening a popup.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle reading mode"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
